# Copy this file to .env and fill in real values.
# All variables exposed to the browser MUST be prefixed with VITE_.

VITE_APP_NAME=Vrushahi Group
VITE_API_URL=http://localhost:5000/api
VITE_PORT=5173

# Optional. Leave empty to run with honeypot + rate-limit spam protection only.
# Setting a key here mounts the Cloudflare Turnstile widget on the Contact and
# Career forms; the backend must get the matching TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
