# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=5000

# Comma-separate to allow several origins (e.g. staging + production).
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of this server. 0 when running directly;
# set to the real hop count behind nginx / a load balancer so rate limiting
# sees genuine client IPs. Never use `true`.
TRUST_PROXY=0

# --- Email -------------------------------------------------------------------
# smtp | resend | console
# "console" logs submissions instead of emailing them, so the forms work
# end-to-end with no mail account. Switch to smtp or resend before launch.
MAIL_PROVIDER=console

MAIL_FROM=Vrushahi Group <no-reply@vrushahi.com>

# TODO(B11.5) — CONFIRM. Where Contact and Career submissions are delivered.
# The legacy PHP mailed techdeshpande@gmail.com, which looks like a developer's
# personal address; confirm the real business inbox. Comma-separate for several.
MAIL_TO=info@vrushahi.com

# Required when MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required when MAIL_PROVIDER=resend
RESEND_API_KEY=

# --- Spam protection ---------------------------------------------------------
# Optional. Leave empty to run with honeypot + timing + rate limiting only.
# When set, must be paired with VITE_TURNSTILE_SITE_KEY on the frontend.
TURNSTILE_SECRET_KEY=

# Reject submissions completed faster than this (ms) — no human is that quick.
MIN_FORM_FILL_MS=3000
# Reject forms left open longer than this (ms). Default 6 hours.
MAX_FORM_AGE_MS=21600000

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
MAX_UPLOAD_BYTES=5242880
